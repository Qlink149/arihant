# Disposable E2E stack ONLY — never point this at production Atlas / arihant_crm.
# Copy to backend/.env.e2e (gitignored). Put your test-cluster MONGO_URL there.
#
# Local Mongo example:
#   MONGO_URL=mongodb://127.0.0.1:27017
# Or a dedicated Atlas test cluster (separate from production):
#   MONGO_URL=mongodb+srv://USER:PASS@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
#
# Always keep DB_NAME=arihant_crm_e2e

MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=arihant_crm_e2e
ENVIRONMENT=e2e
SECRET_KEY=e2e-local-secret-key-min-32-chars-xx
CRON_SECRET=e2e-cron-secret16
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DASHBOARD_URL=http://127.0.0.1:3000
WHATSAPP_PROVIDER=disabled
ALLOW_PUBLIC_REGISTRATION=false

E2E_ADMIN_EMAIL=e2e-admin@arihant.local
E2E_ADMIN_PASSWORD=E2eAdmin!Pass123
E2E_REP_EMAIL=e2e-rep@arihant.local
E2E_REP_PASSWORD=E2eRep!Pass123
E2E_MANAGER_EMAIL=e2e-manager@arihant.local
E2E_MANAGER_PASSWORD=E2eManager!Pass123
E2E_GM_EMAIL=shariff@arihants.co.in
E2E_GM_PASSWORD=E2eGm!Pass123
E2E_API_URL=http://127.0.0.1:8000
