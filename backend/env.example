MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=arihant_crm
# Generate: openssl rand -hex 32
SECRET_KEY=
# Generate: openssl rand -hex 16
CRON_SECRET=
CORS_ORIGINS=http://localhost:3000

# Deployment environment — set to 'production' on server, 'development' locally
# Controls: public registration lock, test auth bypasses
ENVIRONMENT=development

# Internal platform operator — used for server-side impersonation only
PLATFORM_OPERATOR_EMAIL=your-operator@yourdomain.com

# Public self-registration (default off — use scripts or admin API to provision users)
ALLOW_PUBLIC_REGISTRATION=false

# First admin (run once): python scripts/create_admin.py
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Rep/manager users: python scripts/create_user.py
USER_EMAIL=
USER_PASSWORD=
USER_NAME=
USER_ROLE=rep

# Required — Cron (SLA engine trigger)
# Used by Vercel Cron Jobs; Vercel sends: Authorization: Bearer <CRON_SECRET>

# JWT session (Q6 — default 12h)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Brevo internal Admin alerts (Q8)
BREVO_API_KEY=
BREVO_ALERT_EMAIL=
BREVO_SENDER_EMAIL=
DASHBOARD_URL=http://localhost:3000
# Ops: create Brevo template `nurturing_review_alert` (params: lead_count, lead_table, dashboard_url)
# Seed app_settings via Settings UI or Mongo; set CRON_SECRET in production for both crons

# Optional — AI (Groq free tier; OpenAI-compatible)
# GROQ_API_KEY is the primary key; add GROQ_API_KEY_2/_3 for rate-limit rotation fallback
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_MODEL=llama-3.3-70b-versatile
# Legacy aliases (same Groq key if you already use these names):
# GROK_API_KEY_1=
# GROK_MODEL=llama-3.3-70b-versatile
# LLM_PROVIDER=groq
# For paid xAI Grok instead: LLM_PROVIDER=xai, GROK_API_KEY_1=..., GROK_MODEL=grok-2-latest

# Optional — WhatsApp (Gupshup — legacy, not active)
# Webhook HMAC secret (Gupshup x-hub-signature-256)
WHATSAPP_WEBHOOK_SECRET=
GUPSHUP_TOKEN=
GUPSHUP_API_KEY=
GUPSHUP_APP_ID=
GUPSHUP_SOURCE_PHONE=
GUPSHUP_APP_NAME=ArihantSalesIntelligence

# WhatsApp provider selection
# Options: disabled | wati
# Keep 'disabled' until WATI token, approved templates, and webhook are confirmed from client.
# Flip to 'wati' during low-traffic UAT only after Phase 3 checklist is complete.
WHATSAPP_PROVIDER=disabled

# WATI WhatsApp API
# Endpoint: from WATI dashboard → Connector → API (e.g. https://live-mt-server.wati.io/400741)
WATI_API_ENDPOINT=https://live-mt-server.wati.io/400741
WATI_API_TOKEN=
# Channel phone (digits only, with country code, no dashes/spaces)
WATI_CHANNEL_PHONE=
# Public base URL of this API server — used to build PDF download links sent via WhatsApp
# Example: https://api.claraai.tech  (no trailing slash)
WATI_BASE_URL=
# Brochure PDF public URL — share with team when available; WATI sends it via fileViaUrl
WATI_BROCHURE_PDF_URL=

# Meta Conversions API (CAPI) — QualifiedLead events
# Dataset/Pixel ID from Meta Events Manager. Access token from System User or Events Manager.
# Leave META_TEST_EVENT_CODE empty in production; set only when testing against Test Events tab.
META_DATASET_ID=
META_ACCESS_TOKEN=
META_API_VERSION=v21.0
META_TEST_EVENT_CODE=

# Meta Lead Ads webhook (inbound Instant Forms → CRM)
# Different from CAPI META_ACCESS_TOKEN — use Page Access Token with leads_retrieval.
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=383431805163700
META_PAGE_ACCESS_TOKEN=
# Generate: openssl rand -hex 24
META_LEAD_VERIFY_TOKEN=
# JSON form_id → project_id. Defaults in code if left empty.
META_LEAD_FORM_PROJECT_MAP={"2124096745052549":"reserve-16","1874174036585908":"mira","4309061012643289":"melange","28059295887006740":"krsna","1858929181319661":"vivriti"}
